# Cloudflare Workers configuration for AI API Gateway.
# 本文件由 scripts/render-wrangler-config.mjs 从本模板生成 wrangler.toml —— 勿直接修改生成物。
# 改配置数据：**顶层段**编辑 .dev.vars、**[env.*] 段**编辑 .dev.vars.staging（两文件同名键），
# 也可由部署 shell / CI 注入同名环境变量覆盖；改完运行 `npm run render:config`。
# `render:config` **不带也不需要 `--env`**：渲染是段感知的，一次执行就同时产出两个环境的正确内容
# （传 `--env` 会 fail-fast —— 是参数已移除，不是环境坏了）。
# 本地开发（Miniflare）：`npm run dev`（vite dev）。
# 生产部署从零步骤见 CLAUDE.md §部署要点（创建 D1/KV/Queue → 迁移 → secrets/vars → OAuth App → 首个 admin → deploy）。
# 双环境：顶层 = production（wrangler deploy），[env.staging] = staging（wrangler deploy --env staging）。
# **部署哪个环境只由 `wrangler deploy [--env staging]` 决定**，模板与生成物里两环境并存。

name = "{WORKER_NAME}"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

# --- 自定义域名（部署时自动创建/绑定；wrangler v4 已移除 `wrangler domains` 子命令，改用配置声明） ---
# lmlh.net 已托管在 Cloudflare，custom_domain = true 会自动验证并绑定。
# **双域名分流**（09-21-dual-domain-split）：同一 Worker 绑三个 custom domain，**两段同形** ——
#   DOMAIN        = 管理台域（/api/* 与 SPA 深链）
#   API_DOMAIN    = 公开 API 域（/v1、/anthropic）
#   LEGACY_DOMAIN = 旧域转发源（prod = router.lmlh.net / stg = stg-router.lmlh.net）
# 分流与越界互跳见 src/middleware/domain-split.ts（301/308）。旧域**只为保留绑定 + 让旧 base_url
# 继续可用**（按路径转发到本环境的新域）；中间件不读该值，故它不出现在任何 [vars] 里。
# 域名取值：顶层 ← .dev.vars，[env.staging] ← .dev.vars.staging（同名键）。
routes = [
  { pattern = "{DOMAIN}", custom_domain = true },
  { pattern = "{API_DOMAIN}", custom_domain = true },
  { pattern = "{LEGACY_DOMAIN}", custom_domain = true },
]

# --- 静态资源（M6）：Vite 构建产物（React SPA）由 Worker 托管 ---
# 注意：TOML 中顶层键必须写在任何 [table]/[[array]] 表头之前，否则会被并入最后一个表。
# run_worker_first = true：全部请求先到 Worker（Hono 处理 /api/*、/v1/*），
# 其余路径由 Worker 内 env.ASSETS.fetch() 兜底托管。
# not_found_handling=single-page-application：React Router 深链（/login、/keys 等）回退 index.html。
# assets 为顶层属性，staging 环境继承同一构建产物。directory 显式声明（vite-plugin 重定向配置不携带 env 段，
# 直接 `wrangler deploy --config wrangler.toml` 时必须有 directory）。
assets = { binding = "ASSETS", directory = "dist/client", run_worker_first = true, not_found_handling = "single-page-application" }

# --- Placement：Worker 就近 b.ai 后端执行（09-02 网络优化任务落地，2026-09-02 实测） ---
# 亚太客户端 subrequest → api.b.ai 链路优化：targeted us-west-1 → CF 将 Worker 置于 SJC colo
# （cf-placement=remote-SJC），subrequest 从美西短距出口，消除跨太平洋跳。
# 实测三组（LAX vantage, glm-5.3-flash, N=20）：baseline p50=1907ms / us-west-2(SEA) 2146ms /
# us-west-1(SJC) 1739ms（全指标最优；数据方向与 b.ai 后端≈北加州一致）；stg 回归 23/23 全绿。
# 注意：region hint 正确语法为 mode="targeted"+region（wrangler 4.106 schema；旧文档 smart+region 不合法）；
# mode="smart" 为 Smart Placement 自适应形态，如需试验可另在 env 段覆盖（placement 是 inheritable key）。
# 顶层配置同时作用于 production 与 staging（[env.staging] 无覆盖时继承）；assets 静态托管不受影响。
[placement]
mode = "targeted"
region = "aws:us-west-1"

# --- D1：事实库（users / api_keys / providers / balance_tx / request_logs / usage_daily / models） ---
# database_id 由 `wrangler d1 create` 生成后配置到 .dev.vars 的 D1_DB_ID（见 CLAUDE.md §部署要点 步骤 1）。
[[d1_databases]]
binding = "DB"
database_name = "{D1_DB_NAME}"
database_id = "{D1_DB_ID}"
migrations_dir = "drizzle"

# --- KV：响应缓存 + 限流固定窗口计数器（M4 使用） ---
# id 由 `wrangler kv namespace create` 生成后配置到 .dev.vars 的 KV_ID（见 CLAUDE.md §部署要点 步骤 2）。
[[kv_namespaces]]
binding = "CACHE_KV"
id = "{KV_ID}"

# --- 认证面限流（09-28-auth-rate-limit-fix；修复 security-audit 2026-09-23 的 F1） ---
# `/api/auth/*` 此前零速率成本（Better Auth 自带限流挂在 `NODE_ENV === "production"` 上，
# 而 Workers 里 NODE_ENV 是 undefined ⇒ 从未启用）。现改用 Cloudflare 原生 [[ratelimits]] 绑定。
# **策略（limit/period）只在这里，代码侧只传 `{ key }`** —— workerd 生成的 `RateLimitOptions`
# 只有 key 字段（worker-configuration.d.ts），本地 miniflare 虽接受逐调用覆写但生产无此契约。
# 故「同一绑定多策略」不可行 ⇒ 策略不同的类别各占一个 binding，namespace_id 即计数器命名空间。
#
# 三条写配置前必须知道的约束（详见 .trellis/tasks/09-28-auth-rate-limit-fix/design.md §2）：
#  1. **namespace_id 是字面量，不走 RENDER-ENV token 链** —— 与 D1/KV/Queue 刻意不同：那些是
#     Cloudflare 生成的资源 ID，而它是我们自己挑的账号级命名空间，**无需 dashboard 注册**。
#     好处是 RENDER-ENV 键数（22）不变、.dev.vars 两个模板与 config-inventory 均不必动。
#  2. **prod 与 staging 必须用不同 namespace_id** —— 该命名空间是**账号级**的，同 namespace + 同 key
#     的绑定**跨 Worker 共享计数**；本仓两环境是同账号下两个 Worker，共用会导致额度互相吃掉，
#     **且全程无任何报错**。段位约定：prod 用 1xxx、stg 用 2xxx。
#  3. **本字段不继承**（wrangler 标为 notInheritable）—— [env.staging] 段必须另写一份，
#     漏写不报错、只会让 staging 静默不限流。
# period 只能是 10 或 60（wrangler schema 的 enum），limit 为「每周期每 IP 允许次数」。
# 改档位改这里即可，**不用改代码、不用发版**。
[[ratelimits]]
name = "AUTH_CREDENTIAL_LIMIT"
namespace_id = "1001"
simple = { limit = 10, period = 60 }

[[ratelimits]]
name = "AUTH_EMAIL_LIMIT"
namespace_id = "1002"
simple = { limit = 5, period = 60 }

# --- Queues：用量聚合异步管道（M5 使用） ---
[[queues.producers]]
binding = "USAGE_QUEUE"
queue = "{QUEUE_NAME}"

[[queues.consumers]]
queue = "{QUEUE_NAME}"
max_batch_size = 32
max_retries = 3

# --- Queues：延迟计费管道（08-31-perf-v2：成功路径计费解耦，消费者批内扣费） ---
[[queues.producers]]
binding = "BILLING_QUEUE"
queue = "{BILLING_QUEUE_NAME}"

[[queues.consumers]]
queue = "{BILLING_QUEUE_NAME}"
max_batch_size = 32
max_retries = 3

# --- Cron：request_logs 保留期清理（M5 5.4；UTC 每日 02:00；本地 wrangler dev 不自动触发） ---
[triggers]
crons = ["0 2 * * *"]

# --- 非敏感运行时配置（分类依据 spec backend/environment.md §本项目约定） ---
# 治理规则：
# - 真实 secret（GATEWAY_SECRET_KEY / BETTER_AUTH_SECRET / GITHUB_CLIENT_SECRET）→ wrangler secret put / .dev.vars，禁止入本文件。
# - PII 与环境差异值（邮箱白名单/站点 URL/Client ID）→ "{KEY}" 渲染时烘焙字面量（实测 wrangler 4.x
#   不解析 {KEY} 占位符，值必须在构建期就位）：值链 process.env → .dev.vars → DEFAULT_VALUES；
#   部署真实值时在部署 shell export 同名环境变量覆盖（本地 .dev.vars 为 localhost/占位，仅本地 dev 用）。
# - 资源 ID（D1/KV/Queue）为基础设施标识符（非秘密），经模板渲染自 .dev.vars（见上）。
[vars]
BETTER_AUTH_URL = "{BETTER_AUTH_URL}"
GITHUB_CLIENT_ID = "{GITHUB_CLIENT_ID}"
GITHUB_ALLOWED_EMAILS = "{GITHUB_ALLOWED_EMAILS}"
REQUEST_LOG_RETENTION_DAYS = "{REQUEST_LOG_RETENTION_DAYS}"
API_KEY_PREFIX = "{API_KEY_PREFIX}"
# 延迟计费队列名（queue() handler 按队列名分流；与 [[queues.producers]] binding 同名绑定配合）
BILLING_QUEUE_NAME = "{BILLING_QUEUE_NAME}"
# 全局响应缓存总开关（09-03-stg-cache-investigation）：缺省/false = 关闭（即使 key.cacheEnabled=true 也不缓存）；
# 设为 true/1/yes/on 才允许命中/写入（仍需 key.cacheEnabled 且非流式且 ≤32KB）。staging 在 .dev.vars.staging 中给出同名键覆盖。
CACHE_ENABLED = "{CACHE_ENABLED}"
# modelcap 档位乘算常数（09-16 kv-ops O3c 档位化）：cap = MODELCAP_BASE_TOKENS × MODELCAP_MULTIPLIER × 档位
# （src/generated/modelcaps.ts 存档位 1/2/null，xlarge 式算法；缺省 8192 × 2 = 16384 基准）。
# 改动后需重跑 render:modelcaps + 部署（档位按当前常数推导）。
# **陷阱**：render:modelcaps 只读 .dev.vars 的顶层值 —— 生成的档位表（src/generated/modelcaps.ts）
# 是两环境共享的代码，无法按环境分叉。故 staging 不应在这两个键上给出与顶层不同的值
# （渲染脚本对此会 WARN）；确需分叉要先解决档位表的生成方式。
MODELCAP_BASE_TOKENS = "{MODELCAP_BASE_TOKENS}"
MODELCAP_MULTIPLIER = "{MODELCAP_MULTIPLIER}"
# 注册赠金 / 邮箱验证赠金金额（USD，09-16-signup-bonus-grant）：缺省 5（开箱即送）；
# 显式设 0（或非法值）即不赠（涉及钱，非法配置 fail-safe 到少发）。staging 在 .dev.vars.staging 中给出同名键。
SIGNUP_BONUS_AMOUNT = "{SIGNUP_BONUS_AMOUNT}"
EMAIL_VERIFY_BONUS_AMOUNT = "{EMAIL_VERIFY_BONUS_AMOUNT}"
# 邮箱验证功能总开关（09-16-signup-bonus-grant）：缺省 false = 系统休眠（不发验证信、
# 不发验证赠金、前端不展示验证入口）；true/1/yes/on 才开启。staging 在 .dev.vars.staging 中给出同名键。
EMAIL_VERIFICATION_ENABLED = "{EMAIL_VERIFICATION_ENABLED}"
# 账户安全总开关（09-21-email-admin-promotion-switch）：缺省/false = 邮件注册的账户永远不能提升为
# admin（写边界 403 + 画面置灰该操作）；true/1/yes/on 才允许提升。只拦新提升，不倒查存量 admin
# （降级/停用/已是 admin 的幂等重写不受影响）。staging 在 .dev.vars.staging 中给出同名键。
EMAIL_ACCOUNT_ADMIN_PROMOTION_ENABLED = "{EMAIL_ACCOUNT_ADMIN_PROMOTION_ENABLED}"
# 事务邮件收件人白名单（08-27-email-notification；逗号分隔，大小写不敏感，空白项忽略）：
# **空 = 全放行**（prod 语义）。staging **必须在 .dev.vars.staging 中显式设置同名键**，
# 否则测试环境会把验证信发给任意真实用户。名单外收件人静默跳过（记 email_skipped_allowlist）。
# 渲染脚本每次执行都会检查这个危险组合（开关开 + 名单空）并 WARN。
EMAIL_ALLOWED_RECIPIENTS = "{EMAIL_ALLOWED_RECIPIENTS}"
# 公开 API 域名（双域名分流，09-21-dual-domain-split）：/v1、/anthropic 只在 api 域服务，
# 管理面（/api/*）与 SPA 只在管理台域服务；两侧越界路径由中间件互跳。
# **本键同时驱动 routes 绑定与运行时分流**：未配置（或为空）⇒ 分流整体关闭（本地 dev 即此形态，
# 行为与今日完全一致）。须显式声明 —— 刻意不进渲染脚本的 DEFAULT_VALUES（缺了要 fail-fast）。
# 注意 [env.staging.vars] **不继承**顶层 [vars]，该段必须另写一份同名键。
API_DOMAIN = "{API_DOMAIN}"

# ====================================================================
# Staging 环境（wrangler deploy --env staging）
# 与 production 完全隔离：独立 D1/KV/Queue/域名。
# **token 名与顶层段完全相同**：同一套变量名，值来自另一个文件 —— `.dev.vars.staging`。
# 渲染是段感知的（本段内取 .dev.vars.staging，段外取 .dev.vars），故两环境并存于同一份生成物。
# ====================================================================
[env.staging]
name = "{WORKER_NAME}"
# 与顶层同形三条：管理台域 + 公开 API 域 + **旧域转发源** `{LEGACY_DOMAIN}`（= stg-router.lmlh.net）。
# 旧域只用于**绑定**（stg 现存客户端/脚本的 base_url 指着它，保留绑定 + 按路径转发 ⇒ 零改动继续
# 可用）；运行时不读该值，故它不出现在 [env.staging.vars]。顶层段的旧域是 prod 的 router.lmlh.net
# —— 两段各绑自己的旧域，值来自各自的值文件（同 token 名，无需条件渲染）。
routes = [
  { pattern = "{DOMAIN}", custom_domain = true },
  { pattern = "{API_DOMAIN}", custom_domain = true },
  { pattern = "{LEGACY_DOMAIN}", custom_domain = true },
]

[[env.staging.d1_databases]]
binding = "DB"
database_name = "{D1_DB_NAME}"
database_id = "{D1_DB_ID}"
migrations_dir = "drizzle"

[[env.staging.kv_namespaces]]
binding = "CACHE_KV"
id = "{KV_ID}"

# --- 认证面限流 stg 段（09-28-auth-rate-limit-fix） ---
# ⚠ **这段不是上一段的冗余复制**：`[[ratelimits]]` 是 notInheritable（wrangler 标死），
#   漏掉这段的后果**不是报错**，而是 staging 上 `env.AUTH_*_LIMIT` 为 undefined ⇒ 限流静默失效。
#   同时 namespace_id **必须与顶层不同**（账号级命名空间，跨 Worker 共享计数）——段位 2xxx。
[[env.staging.ratelimits]]
name = "AUTH_CREDENTIAL_LIMIT"
namespace_id = "2001"
simple = { limit = 10, period = 60 }

[[env.staging.ratelimits]]
name = "AUTH_EMAIL_LIMIT"
namespace_id = "2002"
simple = { limit = 5, period = 60 }

[[env.staging.queues.producers]]
binding = "USAGE_QUEUE"
queue = "{QUEUE_NAME}"

[[env.staging.queues.consumers]]
queue = "{QUEUE_NAME}"
max_batch_size = 32
max_retries = 3

[[env.staging.queues.producers]]
binding = "BILLING_QUEUE"
queue = "{BILLING_QUEUE_NAME}"

[[env.staging.queues.consumers]]
queue = "{BILLING_QUEUE_NAME}"
max_batch_size = 32
max_retries = 3

[env.staging.triggers]
crons = ["0 2 * * *"]

# --- Placement stg 覆盖（2026-09-14 用户决策）：stg 先行试验 Smart Placement 自适应 ---
# 顶层 targeted aws:us-west-1（09-02 就近 b.ai/SJC）仍作用于 production；smart 由 CF 按上游实测延迟自选 colo。
# 若 stg 试验结论回退或推广 production，改此处/顶层即可；placement 是 inheritable key，显式覆盖阻断继承。
[env.staging.placement]
mode = "smart"

# ====================================================================
# ⚠ 本段的 15 行**不是顶层 [vars] 的冗余复制** —— Cloudflare 平台上 `[env.<name>.vars]`
# **不继承**顶层 `[vars]`。删掉任何一行 = 该变量在 staging 运行时**整体缺失**（不是"退回默认值"，
# 而是 `env.X` 为 undefined）。token 名与顶层相同容易让人误以为可以继承，**切勿"顺手去重"**。
# 契约：本段键集合必须与顶层 [vars] 逐键相等（有单测断言）。
# ====================================================================
[env.staging.vars]
BETTER_AUTH_URL = "{BETTER_AUTH_URL}"
GITHUB_CLIENT_ID = "{GITHUB_CLIENT_ID}"
GITHUB_ALLOWED_EMAILS = "{GITHUB_ALLOWED_EMAILS}"
REQUEST_LOG_RETENTION_DAYS = "{REQUEST_LOG_RETENTION_DAYS}"
API_KEY_PREFIX = "{API_KEY_PREFIX}"
BILLING_QUEUE_NAME = "{BILLING_QUEUE_NAME}"
CACHE_ENABLED = "{CACHE_ENABLED}"
MODELCAP_BASE_TOKENS = "{MODELCAP_BASE_TOKENS}"
MODELCAP_MULTIPLIER = "{MODELCAP_MULTIPLIER}"
# staging 赠金：值与顶层各取各的（未在 .dev.vars.staging 中给出时回退到 .dev.vars → 缺省 5）。
# stg 若不希望真实产生赠金流水，在 .dev.vars.staging 中设 SIGNUP_BONUS_AMOUNT=0。
SIGNUP_BONUS_AMOUNT = "{SIGNUP_BONUS_AMOUNT}"
EMAIL_VERIFY_BONUS_AMOUNT = "{EMAIL_VERIFY_BONUS_AMOUNT}"
EMAIL_VERIFICATION_ENABLED = "{EMAIL_VERIFICATION_ENABLED}"
# stg 账户安全总开关（取 .dev.vars.staging 的同名键；未设则回退，缺省 false = 邮件注册账户不可提升为 admin）
EMAIL_ACCOUNT_ADMIN_PROMOTION_ENABLED = "{EMAIL_ACCOUNT_ADMIN_PROMOTION_ENABLED}"
# stg 事务邮件收件人白名单：**必须在 .dev.vars.staging 中显式设置**（staging 隔离真实用户；空 = 全放行，会误发）
EMAIL_ALLOWED_RECIPIENTS = "{EMAIL_ALLOWED_RECIPIENTS}"
# stg 公开 API 域（取 .dev.vars.staging 的同名键）。
# 旧域 stg-router.lmlh.net 的转发**不需要**在这里声明 —— 中间件按「host 既不是 DOMAIN 也不是
# API_DOMAIN ⇒ 按路径转发」处理，运行时不读 LEGACY_DOMAIN（它只在 routes 里做绑定）。
API_DOMAIN = "{API_DOMAIN}"
